#!/usr/bin/env bash
set -Eeuo pipefail

# Install Claude Code from a previously downloaded archive.
# Expected env: ASDF_INSTALL_VERSION, ASDF_INSTALL_PATH, ASDF_DOWNLOAD_PATH

version="${ASDF_INSTALL_VERSION:?ASDF_INSTALL_VERSION is required}"
install_path="${ASDF_INSTALL_PATH:?ASDF_INSTALL_PATH is required}"
download_path="${ASDF_DOWNLOAD_PATH:?ASDF_DOWNLOAD_PATH is required}"

mkdir -p "${install_path}/bin"
cp "${download_path}/claude" "${install_path}/bin/claude"
chmod +x "${install_path}/bin/claude"

if "${install_path}/bin/claude" --version >/dev/null 2>&1; then
    echo "Claude Code ${version} installed successfully."
else
    echo "Warning: claude --version check failed, but binary was installed." >&2
fi
